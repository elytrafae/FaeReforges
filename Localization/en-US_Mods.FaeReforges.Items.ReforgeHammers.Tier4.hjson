}

StardustTinkererHammer: {
	SummonWeaponEffect:
		'''
		Dodging an attack or getting hurt makes all summons 
		you have from this {0}x faster for a brief moment. 
		This effect has a {1} second cooldown and {2} charges.
		'''
	WhipWeaponEffect:
		'''
		+{0} Summon Tag Damage
		+{1}% summon tag critical strike chance
		This bonus does not stack with itself.
		'''
	WeaponEffectText:
		'''
		[c/ba03b7:If used on a whip:]
		{$Mods.FaeReforges.Items.ReforgeHammers.Tier4.StardustTinkererHammer.WhipWeaponEffect}
		[c/ba03b7:If used on a minion or sentry:]
		{$Mods.FaeReforges.Items.ReforgeHammers.Tier4.StardustTinkererHammer.SummonWeaponEffect@2}
		'''
	AccessoryEffectText: "{$Mods.FaeReforges.PowerOf.Five}: +1 Summon and Sentry Slots"
	DisplayName: Stardust Tinkerer Hammer
	Tooltip: ""
}

