BeetleTinkererHammer: {
	WeaponEffectText:
		'''
		Dealing damage has a {0}% chance to spawn a Beetle, 
		dealing {1}% of the hit's damage. This Beetle
		does not interact with other Beetle effects.
		Can only have {2} Beetles at once.
		'''
	AccessoryEffectText: ""
	DisplayName: Beetle Tinkerer Hammer
	Tooltip: ""
}

